{
  "tasks": {
    "serve": "deno serve main.tsx",
    "test": "deno test --allow-net",
    "lint": "deno lint"
  },

  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"]
    }
  },

  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "@hono/hono/jsx"
  },

  "nodeModulesDir": "none",
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.12.18",
    "tailwindcss": "npm:tailwindcss@^4.3.0"
  }
}
